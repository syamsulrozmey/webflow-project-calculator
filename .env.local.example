# Local development defaults match docker-compose.yml. Do not use these in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webflow_calc?schema=public"
REDIS_URL="redis://localhost:6379"

# Optional: use the ID of a local Prisma User for the mock project API identity.
# This is not authentication and must not be used to protect production data.
NEXT_PUBLIC_MOCK_USER_ID=
NEXT_PUBLIC_FEATURE_TIER=free
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional service keys. Leave blank if those features are not needed locally.
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
CURRENCY_API_KEY=

# Optional OpenRouter request attribution; defaults are used when blank.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
